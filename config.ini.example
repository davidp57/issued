[library]
path = /path/to/comics
name = My Comic Library

[server]
host = 0.0.0.0
port = 8181

[thumbnails]
width = 300
height = 450
quality = 85
format = jpeg

[scanner]
supported_formats = cbz,cbr,cb7,pdf
ignore_patterns = .DS_Store,Thumbs.db,@eaDir
unrar_tool = unrar

[monitoring]
# Enable automatic file monitoring when server is running
enabled = true
# Debounce delay in seconds (avoid multiple events for same file)
debounce_seconds = 2

[reader]
# Web reader login (leave empty to allow access without password)
user =
password =
# Token for automation tools calling /reader/api/* with the X-Issued-Token
# header (at least 32 characters). ISSUED_API_TOKEN overrides it.
# api_token =

[deletion]
# Delete action in the web reader: off, delete (removes the file from disk)
# or trash (moves it to trash_path, which must lie outside the library)
mode = off
trash_path =
